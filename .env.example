# ── CYF — Configuration ───────────────────────────────────────────
# Copier ce fichier en .env et adapter les valeurs

# Port du serveur (défaut : 3000)
PORT=3000

# Environnement : 'development' | 'production'
NODE_ENV=development

# Chemin de la base SQLite (défaut : server/db/cyf.sqlite)
# DB_PATH=

# ── Administration ───────────────────────────────────────────────
# Mot de passe du dashboard club (/admin.html). OBLIGATOIRE en production.
# Sans lui, un mot de passe temporaire est généré à chaque démarrage
# et affiché dans la console.
ADMIN_PASSWORD=

# Clé de signature des sessions admin (chaîne aléatoire longue).
# Facultative : sans elle, les admins doivent se reconnecter après
# chaque redémarrage du serveur.
# SESSION_SECRET=

# Derrière un proxy (nginx, hébergeur) : 1 pour lire la vraie IP des
# visiteurs (utile au blocage anti force brute).
# TRUST_PROXY=1

# Origine CORS autorisée en production (séparées par virgules)
# Exemple : https://cyf.smcaen.fr,https://admin.smcaen.fr
# CORS_ORIGINS=https://your-domain.com

# Logging : 'info' | 'debug' | 'warn' | 'error'
# LOG_LEVEL=info

# ── Notes ─────────────────────────────────────────────────────────
# • En production, ne JAMAIS laisser CORS_ORIGINS vide ou '*'
# • Le serveur utilise better-sqlite3 (synchrone, rapide, pas besoin de pool)
# • Le PWA fonctionne sans configuration particulière
